# Persistence connection variable. Supply a deployment-specific value locally;
# never commit credentials or a real connection string.
MONGO_URL=<set-your-mongodb-url>
MONGO_DB_NAME=aero_digital_twin_db

# Shared key used by the local FastAPI services. Use the same local value for
# every service and replace this placeholder outside version control.
INTERNAL_SERVICE_KEY=<set-a-local-shared-key>

# The production/demo live path is Simulink replay over UDP/CAN.
TELEMETRY_INPUT_MODE=simulink
